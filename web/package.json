{
  "name": "sp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "dev:fixtures": "NEXT_PUBLIC_SP_FIXTURES=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../server/openapi.json -o src/lib/api/openapi.gen.ts",
    "fixture:capture": "node --experimental-strip-types scripts/capture-sample.ts --write",
    "scene:types": "json2ts -i ../core/schema/scene.schema.json -o src/lib/scene/scene.gen.ts --no-additionalProperties --bannerComment '/* Generated from core/schema/scene.schema.json by pnpm scene:types. Do not edit. */'",
    "e2e:server": "playwright test -c playwright.server.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^26",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  }
}
