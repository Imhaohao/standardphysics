# TLS, and the only thing on the box listening to the internet.
#
# Caddy gets a certificate from Let's Encrypt on first boot and renews it
# without being asked. That needs port 80 reachable and the DNS already
# pointing here.

# One definition of the upstream, because both names send /api to it. The
# timeouts are for a slow walk around a big shop on shop Wi-Fi.
(scan_api) {
	reverse_proxy api:8787 {
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
}

{$API_DOMAIN} {
	import scan_api
	request_body {
		max_size 1GB
	}
}

# People type the bare name, so that is what the workspace answers on.
{$APP_DOMAIN} {
	# /api is the backend's, not Next's. The workspace has no route handlers
	# of its own under it, and `next build` bakes the rewrite destination into
	# routes-manifest.json, so SP_API_ORIGIN set at runtime never reaches the
	# rewrite: the workspace container would proxy to its own 127.0.0.1:8787,
	# where nothing is listening, and answer 500. Sending /api straight to the
	# API from here is both correct and one hop shorter.
	handle /api/* {
		import scan_api
	}
	handle {
		reverse_proxy web:3000 {
			# Reconstruction can hold a request open while a model call
			# finishes, which next.config.ts already allows three minutes for.
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	request_body {
		max_size 1GB
	}
}

www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
