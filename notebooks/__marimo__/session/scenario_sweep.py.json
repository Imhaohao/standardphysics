    {
      "id": "nWHF",
      "code_hash": "6bee5a0db02466b9a9d9528aabb3af5f",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "\n    <ul style=\"padding:0;margin:0\">\n    <li style=\"padding:0.75rem 0.9rem;background:#fcfbf8;\n               border-radius:0.5rem;\n               box-shadow:inset 3px 0 0 #c8372d;\n               margin-bottom:0.4rem;list-style:none\">\n      <div style=\"color:#1b1c1e;font-weight:600\">The ordering counter is too high to order from</div>\n      <div style=\"color:#5d5e61;font-size:0.875rem;margin-top:0.2rem\">\n        It's 47 inches high. Ordering from a wheelchair needs 36 inches or lower.\n      </div>\n      <div style=\"color:#8a8a88;font-size:0.8125rem;margin-top:0.2rem\">\n        2010 ADA Standards for Accessible Design 904.4.1\n      </div>\n    </li>\n    \n    <li style=\"padding:0.75rem 0.9rem;background:#fcfbf8;\n               border-radius:0.5rem;\n               box-shadow:inset 3px 0 0 #c8372d;\n               margin-bottom:0.4rem;list-style:none\">\n      <div style=\"color:#1b1c1e;font-weight:600\">The path to the counter is too narrow</div>\n      <div style=\"color:#5d5e61;font-size:0.875rem;margin-top:0.2rem\">\n        It's 31 inches at the tightest point. Wheelchairs need 36 inches.\n      </div>\n      <div style=\"color:#8a8a88;font-size:0.8125rem;margin-top:0.2rem\">\n        2010 ADA Standards for Accessible Design 403.5.1\n      </div>\n    </li>\n    </ul>\n    <p style=\"color:#8a8a88;font-size:0.875rem;margin-top:0.6rem\">\n      6 other measurements came back inside their limit.\n    </p>\n    "
          }
        }
