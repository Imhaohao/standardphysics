      "outputs": [
        {
          "type": "data",
          "data": {
            "text/html": "<div style='display: flex;flex: 1;flex-direction: column;justify-content: flex-start;align-items: normal;flex-wrap: nowrap;gap: 0.5rem'><span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">Each row is a check. Its bar covers the settings it reported a problem at.</span></span><div style=\"display:flex;gap:1.5rem;font-size:0.875rem;color:#5d5e61;margin-bottom:0.5rem;flex-wrap:wrap\"><span style=\"display:inline-flex;align-items:center;gap:0.4rem\"><span style=\"width:18px;height:6px;border-radius:3px;background:#c8372d\"></span>Reported a problem</span><span style=\"display:inline-flex;align-items:center;gap:0.4rem\"><span style=\"width:18px;height:3px;border-radius:3px;background:#2e7d4f\"></span>Inside its limit</span></div><svg viewBox=\"0 0 720 262\" width=\"100%\" role=\"img\" aria-label=\"What each check said as the gap between the display cases changes.\" style=\"max-width:720px;overflow:visible\"><title>What each check said as the gap between the display cases changes.</title><rect x=\"321.0\" y=\"55.0\" width=\"78.4\" height=\"13\" rx=\"4\" fill=\"#c8372d\" /><rect x=\"401.4\" y=\"60.0\" width=\"303.6\" height=\"3\" rx=\"1.5\" fill=\"#2e7d4f\" /><rect x=\"321.0\" y=\"82.0\" width=\"384.0\" height=\"13\" rx=\"4\" fill=\"#c8372d\" /><rect x=\"321.0\" y=\"114.0\" width=\"384.0\" height=\"3\" rx=\"1.5\" fill=\"#2e7d4f\" /><rect x=\"321.0\" y=\"141.0\" width=\"384.0\" height=\"3\" rx=\"1.5\" fill=\"#2e7d4f\" /><rect x=\"321.0\" y=\"168.0\" width=\"384.0\" height=\"3\" rx=\"1.5\" fill=\"#2e7d4f\" /><rect x=\"321.0\" y=\"195.0\" width=\"384.0\" height=\"3\" rx=\"1.5\" fill=\"#2e7d4f\" /><text x=\"0\" y=\"65.5\" font-size=\"13\" fill=\"#1b1c1e\">The path is too narrow</text><text x=\"0\" y=\"92.5\" font-size=\"13\" fill=\"#1b1c1e\">The counter is too high to order from</text><text x=\"0\" y=\"119.5\" font-size=\"13\" fill=\"#8a8a88\">The doorway is too narrow</text><text x=\"0\" y=\"146.5\" font-size=\"13\" fill=\"#8a8a88\">The way out is blocked</text><text x=\"0\" y=\"173.5\" font-size=\"13\" fill=\"#8a8a88\">There is nowhere to pass another customer</text><text x=\"0\" y=\"200.5\" font-size=\"13\" fill=\"#8a8a88\">There is not enough room to pull up to the counter</text><line x1=\"416.5\" y1=\"42.0\" x2=\"416.5\" y2=\"216.0\" stroke=\"#f6f5f1\" stroke-width=\"4\"  /><line x1=\"416.5\" y1=\"42.0\" x2=\"416.5\" y2=\"216.0\" stroke=\"#1b1c1e\" stroke-width=\"1.5\"  /><text x=\"416.5\" y=\"18.0\" font-size=\"12\" fill=\"#1b1c1e\" text-anchor=\"middle\">36 in asked for</text><line x1=\"376.3\" y1=\"42.0\" x2=\"376.3\" y2=\"216.0\" stroke=\"#f6f5f1\" stroke-width=\"4\"  /><line x1=\"376.3\" y1=\"42.0\" x2=\"376.3\" y2=\"216.0\" stroke=\"#2f5e9e\" stroke-width=\"1.5\" stroke-dasharray=\"3 3\" /><text x=\"376.3\" y=\"34.0\" font-size=\"12\" fill=\"#2f5e9e\" text-anchor=\"middle\">31 in now</text><line x1=\"320\" y1=\"216.0\" x2=\"706\" y2=\"216.0\" stroke=\"#e3e0d8\" stroke-width=\"1\" /><text x=\"320.0\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">24</text><text x=\"368.2\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">30</text><text x=\"416.5\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">36</text><text x=\"464.8\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">42</text><text x=\"513.0\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">48</text><text x=\"561.2\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">54</text><text x=\"609.5\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">60</text><text x=\"657.8\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">66</text><text x=\"706.0\" y=\"234.0\" font-size=\"12\" fill=\"#8a8a88\" text-anchor=\"middle\" style=\"font-variant-numeric:tabular-nums\">72</text><text x=\"513.0\" y=\"253.0\" font-size=\"12\" fill=\"#5d5e61\" text-anchor=\"middle\">Gap between the display cases (inches)</text></svg></div>"
