        ],
        "operationId": "live_socket",
        "parameters": [
          {
            "name": "scan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "token",
            "in": "query",
            "description": "Session token, for browsers that cannot set headers",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "in": "query",
            "description": "`viewer` for a read-only subscription",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade. Client sends ClientMessage JSON text frames, server sends ServerMessage."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
