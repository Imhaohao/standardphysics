  "components": {
    "schemas": {
      "AppleSignIn": {
        "type": "object",
        "required": [
          "identity_token"
        ],
        "properties": {
          "identity_token": {
            "type": "string"
          },
          "nonce": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Artifact": {
        "type": "object",
        "required": [
          "id",
          "scan_id",
          "upload_id",
          "kind",
          "filename",
          "content_type",
          "size_bytes",
          "sha256",
          "created_at"
        ],
        "properties": {
          "content_type": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "filename": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "scan_id": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          },
          "upload_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "expires_at",
          "user"
        ],
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "ClientMessage": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/RoomUpdate"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "room"
                    ]
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "ping"
                ]
              }
            }
          }
        ]
      },
      "CompleteUpload": {
        "type": "object",
        "required": [
          "sha256"
        ],
        "properties": {
          "sha256": {
            "type": "string"
          }
        }
      },
      "CreateScan": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "site_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CreateUpload": {
        "type": "object",
        "required": [
          "kind",
          "filename",
          "content_type",
          "size_bytes"
        ],
        "properties": {
          "content_type": {
            "type": "string"
          },
          "filename": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "part_size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "size_bytes": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Finding": {
        "type": "object",
        "required": [
          "rule_id",
          "jurisdiction",
          "section",
          "subject_id",
          "status",
          "message"
        ],
        "properties": {
          "evidence": {
            "type": [
              "object",
              "null"
            ]
          },
          "jurisdiction": {
            "type": "string"
          },
          "measured": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Measured"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "required": {
            "type": [
              "object",
              "null"
            ]
          },
          "rule_id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/FindingStatus"
          },
          "subject_id": {
            "type": "string"
          }
        }
      },
      "FindingStatus": {
        "type": "string",
        "enum": [
          "pass",
          "fail",
          "needs_info",
          "not_applicable"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Measured": {
        "type": "object",
        "required": [
          "value",
          "unit"
        ],
        "properties": {
          "unit": {
            "type": "string"
          },
