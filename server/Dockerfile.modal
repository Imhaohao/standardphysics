# Modal adds Python to the image it runs, which needs a shell, so this variant of
# server/Dockerfile uses Debian slim instead of distroless. Built by server/deploy/modal_app.py.
FROM rust:1-bookworm AS build
WORKDIR /repo
COPY core ./core
COPY rules ./rules
COPY server ./server
WORKDIR /repo/server
RUN cargo build --release --locked --bin sp-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=build /repo/server/target/release/sp-server /usr/local/bin/sp-server
ENV PORT=8080 LOG_FORMAT=json
EXPOSE 8080
